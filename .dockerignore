# Keep the Docker build context lean. Package builds include the maintained
# dictionary through packaging/purelib; everything below would bloat the upload
# or, in the case of .env, leak secrets into the image.

# Original dev/deploy hygiene
.venv/
node_modules/
deploy/cloudflare/node_modules/
image-output/
.git/
.github/
output/
spicy-regs-data/
notebooks/
sample-data/
*.pyc
__pycache__/
.vercel/
.claude/
.vscode/
.agent/

# Not needed in the MCP container image
tests/
docs/
scripts/
recovery/
mcp-server/
graphify-out/
*.parquet
.env
.env.*
